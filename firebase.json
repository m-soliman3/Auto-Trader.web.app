{
  "hosting": [
    {
      "target": "prod",
      "public": "dist/auto-trading/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/getPortfolio",
          "function": {
            "functionId": "getPortfolioHttp",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/getMarketData",
          "function": {
            "functionId": "getMarketData",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/contact",
          "function": {
            "functionId": "sendContactMessage",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/requestLearnCodeAccess",
          "function": {
            "functionId": "requestLearnCodeAccess",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/verifyLearnCodeAccess",
          "function": {
            "functionId": "verifyLearnCodeAccess",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/createPremiumSubscriptionIntent",
          "function": {
            "functionId": "createPremiumSubscriptionIntent",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/confirmPremiumSubscriptionActivation",
          "function": {
            "functionId": "confirmPremiumSubscriptionActivation",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/getPremiumBillingOverview",
          "function": {
            "functionId": "getPremiumBillingOverview",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/cancelPremiumSubscription",
          "function": {
            "functionId": "cancelPremiumSubscription",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/createPayPalSubscription",
          "function": {
            "functionId": "createPayPalSubscription",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/confirmPayPalSubscription",
          "function": {
            "functionId": "confirmPayPalSubscription",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/createTopUpIntent",
          "function": {
            "functionId": "createTopUpIntent",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/confirmTopUp",
          "function": {
            "functionId": "confirmTopUp",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/createNowPaymentsOrder",
          "function": {
            "functionId": "createNowPaymentsOrder",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/checkNowPaymentsOrder",
          "function": {
            "functionId": "checkNowPaymentsOrder",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/listNowPaymentsCurrencies",
          "function": {
            "functionId": "listNowPaymentsCurrencies",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/nowPaymentsCallback",
          "function": {
            "functionId": "nowPaymentsCallback",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/shopify/auth",
          "function": {
            "functionId": "shopifyAuth",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/shopify/callback",
          "function": {
            "functionId": "shopifyCallback",
            "region": "europe-west1"
          }
        },
        {
          "source": "/v1/chat",
          "run": {
            "serviceId": "auto-trader-chatbot-backend",
            "region": "europe-west1"
          }
        },
        {
          "source": "/v1/public-chat",
          "run": {
            "serviceId": "auto-trader-chatbot-backend",
            "region": "europe-west1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "auto-trader-chatbot-backend",
            "region": "europe-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.csr.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
          ]
        },
        {
          "source": "/i18n/**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Pragma", "value": "no-cache" }
          ]
        }
      ]
    },
