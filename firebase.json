{
  "hosting": {
    "site": "autotrader-b8851",
    "public": "dist/auto-trading/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/getPortfolio",
        "function": {
          "functionId": "getPortfolioHttp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/getMarketData",
        "function": {
          "functionId": "getMarketData",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/contact",
        "function": {
          "functionId": "sendContactMessage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/v1/chat",
        "run": {
          "serviceId": "auto-trader-chatbot-backend",
          "region": "europe-west1"
        }
      },
      {
        "source": "/v1/public-chat",
        "run": {
          "serviceId": "auto-trader-chatbot-backend",
          "region": "europe-west1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "auto-trader-chatbot-backend",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
