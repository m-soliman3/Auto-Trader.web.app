{
  "hosting": {
    "site": "autotrader-b8851",
    "public": "dist/auto-trading/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/getPortfolio",
        "function": {
          "functionId": "getPortfolioHttp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/executeStrategy",
        "function": {
          "functionId": "executeStrategyHttp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/getInstrumentChart",
        "function": {
          "functionId": "getInstrumentChartHttp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/liquidatePosition",
        "function": {
          "functionId": "liquidatePositionHttp",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
