{
  "name": "auto-trading",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-i18n-version.mjs",
    "build": "ng build",
    "postbuild": "node scripts/verify-prerender.mjs",
    "build:prod": "npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy:prod": "npm run build:prod && firebase deploy --only hosting:prod",
    "deploy:staging": "npm run build:prod && firebase deploy --only hosting:staging",
    "deploy:staging:preview": "npm run build:prod && firebase hosting:channel:deploy staging --only hosting:staging",
    "i18n:sync-features": "node scripts/sync-feature-pages-i18n.mjs",
    "chatbot:dev": "npm --prefix chatbot-backend run dev",
    "chatbot:build": "npm --prefix chatbot-backend run build",
    "chatbot:start": "npm --prefix chatbot-backend run start"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.2.14",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.2.12",
    "@emailjs/browser": "^4.4.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@stripe/stripe-js": "^9.1.0",
    "firebase": "^12.9.0",
    "firebase-functions": "^7.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.5",
    "@angular/cli": "^21.1.5",
    "@angular/compiler-cli": "^21.1.0",
    "@google-cloud/resource-manager": "^6.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "bing-translate-api": "^4.2.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
